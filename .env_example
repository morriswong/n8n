# Copy this file to .env and fill in your values:
#   cp .env_example .env

# Public URL for n8n (must match your Cloudflare Tunnel hostname)
WEBHOOK_URL=https://n8n.yourdomain.com

# Shared secret between n8n and the runner sidecar
# Generate with: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=

# Optional: Anthropic API key for Claude-based workflows
ANTHROPIC_API_KEY=
