# Anthropic API Key for Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# n8n Webhook URL - Change this to your desired webhook endpoint
WEBHOOK_URL=https://your-n8n-webhook-url.com

# Shared secret between n8n and the runner sidecar (generate with: openssl rand -hex 32)
N8N_RUNNERS_AUTH_TOKEN=your_runner_auth_token_here
